# ─── Obligatorias ────────────────────────────────────────────────────────────
# Sin estas el proceso no arranca (ver src/config/env.validation.ts).

DATABASE_URL="postgresql://user:password@host:5432/flexpress"

# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="3d"

# ─── Entorno ─────────────────────────────────────────────────────────────────

NODE_ENV="development"   # development | production
PORT="3000"
TZ="America/Argentina/Buenos_Aires"

# Orígenes permitidos por CORS, separados por coma. Aplica tanto a HTTP como a
# Socket.IO. Si se deja vacío se usan los defaults de src/config/configuration.ts.
CORS_ORIGINS="http://localhost:3001,https://flexpress-front.vercel.app"

# ─── Swagger ─────────────────────────────────────────────────────────────────
# Solo se pide basic auth cuando NODE_ENV=production, pero ahí son obligatorias:
# el fallback del código es admin/admin123.

SWAGGER_USERNAME="admin"
SWAGGER_PASSWORD=""

# ─── DigitalOcean Spaces (subida de archivos) ────────────────────────────────
# Si faltan, la app arranca igual pero las subidas fallan con 400.

DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_REGION="nyc3"
DO_SPACES_BUCKET=""
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_CDN_BASE="https://<bucket>.<region>.cdn.digitaloceanspaces.com"
SPACES_ENV="dev"          # prefijo de entorno dentro del bucket
DO_SPACES_URL_TTL="3600"  # TTL de las URLs firmadas de lectura (segundos)
DO_SPACES_UPLOAD_TTL="300" # TTL de los PUT presignados (segundos)

# ─── Push notifications (VAPID) ──────────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
# Si faltan, la app arranca pero no se envían push.

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@flexpress.com"

# ─── MercadoPago ─────────────────────────────────────────────────────────────
# Declaradas en configuration.ts pero todavía sin usar: el flujo de recarga es
# manual (el admin aprueba el comprobante).

MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
